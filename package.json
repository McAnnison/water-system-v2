{
  "name": "sdk-water-operations",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @sdk-water/web",
    "build:web": "npm run build --workspace @sdk-water/web",
    "dev:api": "npm run dev --workspace @sdk-water/api",
    "build:api": "npm run build --workspace @sdk-water/api",
    "build": "npm run build:web && npm run build:api"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
